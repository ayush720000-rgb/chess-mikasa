# TELEGRAM_BOT_TOKEN: The Bot API token from @BotFather.
# Enables bot commands, inline match invitations, and Telegram Mini App launch.
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# BOT_USERNAME: The bot handle without the @ (default Ig_MikasaBot). Used until the bot checks its own name.
BOT_USERNAME="Ig_MikasaBot"

# APP_URL: The public URL where this app is hosted, e.g. https://your-service.onrender.com
# Used for self-referential links. Falls back to RENDER_EXTERNAL_URL, then http://localhost:3000.
APP_URL="MY_APP_URL"
